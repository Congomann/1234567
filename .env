PORT=3001
SECRET_KEY=nhfg_secret_key_123
# Vercel/Supabase Connection String
# Use Transaction Mode (port 6543) for serverless
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
NODE_ENV=development

# ── Plaid API Keys ────────────────────────────────────────────────────────────
# Environment: sandbox | development | production
# ⚠️  Change PLAID_ENV=production AND swap PLAID_SECRET → PLAID_SECRET_PRODUCTION
#     only when you are ready to go live with real bank accounts.
PLAID_ENV=sandbox

# Shared across all environments
PLAID_CLIENT_ID=69acce04b0c813000cd1ba83

# Active secret — currently set to SANDBOX
PLAID_SECRET=07dc270ff6a84716ae6bc7e50ac3e4

# Production secret — NOT active until you update PLAID_ENV + PLAID_SECRET above
PLAID_SECRET_PRODUCTION=c024ff72dbf79cb87c4b73427a92da

# Products to request — auth + transactions for 7-day history + balance
PLAID_PRODUCTS=auth
# Country codes — comma-separated: US,CA,GB
PLAID_COUNTRY_CODES=US
# Optional webhook for real-time notifications (set to your public URL)
PLAID_WEBHOOK_URL=

# ── App URL (used in client verification links) ───────────────────────────────
# Production URL (Change to your Vercel domain)
APP_URL=https://new-holland-financial.vercel.app

# ── Email (SMTP via nodemailer) ───────────────────────────────────────────────
